{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "archive/**"
    ],
    "maxVersions": 5,
    "rewrites": [
      {
        "source": "/chat/**",
        "run": {
          "serviceId": "iaiproxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/_next/**",
        "run": {
          "serviceId": "iaiproxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/sessions/**",
        "run": {
          "serviceId": "iaiproxy",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp4|pdf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}
